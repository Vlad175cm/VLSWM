#!/bin/sh
# Record the screen with wf-recorder.
# Usage: vlswm-record [start|stop|toggle]   (default: toggle)
# Bind it in vlswm:
#   [commands]
#   record = "vlswm-record start"
#   record_stop = "vlswm-record stop"
#
# Audio source comes from the config:
#   [record]
#   audio = "mic"      # mic | system | both

runtime="${XDG_RUNTIME_DIR:-/tmp}"
pidfile="$runtime/vlswm-record.pid"
statefile="$runtime/vlswm-record.state"
modfile="$runtime/vlswm-record.modules"
state="${XDG_STATE_HOME:-$HOME/.local/state}/vlswm"
log="$state/record.log"
mode="${1:-toggle}"
out=""
audio_device=""

notify() {
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -a vlswm -t 2000 "$@" >/dev/null 2>&1
}

mkdir -p "$state"

is_recorder() {
    [ -n "$1" ] && kill -0 "$1" 2>/dev/null &&
        [ "$(ps -p "$1" -o comm= 2>/dev/null)" = "wf-recorder" ]
}

cleanup_audio() {
    [ -f "$modfile" ] || return 0
    while read -r mod; do
        [ -n "$mod" ] && pactl unload-module "$mod" >/dev/null 2>&1
    done <"$modfile"
    rm -f "$modfile"
}

stop_recording() {
    pid="$1"
    file="$2"
    kill -INT "$pid" 2>/dev/null || true
    # wf-recorder writes the mp4 trailer on exit: wait for it before returning
    i=0
    while kill -0 "$pid" 2>/dev/null; do
        i=$((i + 1))
        [ "$i" -ge 200 ] && break
        sleep 0.05
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null || true
        sleep 0.5
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$pidfile"
    rm -f "$statefile"
    cleanup_audio

    if [ -n "$file" ] && [ -f "$file" ]; then
        size=$(stat -c %s "$file" 2>/dev/null || echo 0)
        if [ "$size" -gt 1024 ]; then
            notify "Recording saved" "$(basename "$file") ($(du -h "$file" | cut -f1))"
        else
            notify "Recording failed" "see $log"
        fi
    fi
}

audio_mode() {
    cfg="$HOME/.config/vlswm/config"
    mode=$(awk -F'=' '
        /^\[/ { sec = $0; next }
        sec == "[record]" && $1 ~ /^[ \t]*audio[ \t]*$/ {
            gsub(/[ \t"]/, "", $2); print $2; exit
        }' "$cfg" 2>/dev/null)
    case "$mode" in
    system | both) echo "$mode" ;;
    *) echo "mic" ;;
    esac
}

setup_audio() {
    case "$(audio_mode)" in
    system)
        audio_device="$(pactl get-default-sink 2>/dev/null).monitor"
        ;;
    both)
        rm -f "$modfile"
        if ! command -v pactl >/dev/null 2>&1; then
            audio_device=""
            return 0
        fi
        m1=$(pactl load-module module-null-sink sink_name=vlswm_mix \
            sink_properties=device.description=vlswm-mix 2>/dev/null) || { audio_device=""; return 0; }
        echo "$m1" >"$modfile"
        mic="$(pactl get-default-source 2>/dev/null)"
        sink="$(pactl get-default-sink 2>/dev/null)"
        m2=$(pactl load-module module-loopback source="$mic" sink=vlswm_mix latency_msec=50 2>/dev/null)
        m3=$(pactl load-module module-loopback source="$sink.monitor" sink=vlswm_mix latency_msec=50 2>/dev/null)
        if [ -z "$m2" ] || [ -z "$m3" ]; then
            cleanup_audio
            audio_device=""
            return 0
        fi
        echo "$m2" >>"$modfile"
        echo "$m3" >>"$modfile"
        audio_device="vlswm_mix.monitor"
        ;;
    *)
        audio_device=""
        ;;
    esac
}

if [ -f "$pidfile" ]; then
    pid=""
    started=""
    old=""
    read -r pid started old <"$pidfile" 2>/dev/null || true
    if is_recorder "$pid"; then
        if [ "$mode" = "start" ]; then
            notify "Already recording" "$(basename "$old")"
            exit 0
        fi
        now=$(date +%s)
        # do not interrupt wf-recorder while it is still initializing
        if [ -n "$started" ] && [ $((now - started)) -lt 1 ]; then
            sleep 1
        fi
        stop_recording "$pid" "$old"
        exit 0
    fi
    rm -f "$pidfile"
    cleanup_audio
fi

if [ "$mode" = "stop" ]; then
    rm -f "$statefile"
    cleanup_audio
    notify "Not recording"
    exit 0
fi

if ! command -v wf-recorder >/dev/null 2>&1; then
    notify "Recording failed" "wf-recorder is not installed"
    exit 1
fi

mkdir -p "$HOME/Videos"
out="$HOME/Videos/review-$(date +%Y-%m-%d-%H%M%S).mp4"

start_recording() {
    codec="$1"
    with_audio="$2"
    # shellcheck disable=SC2086
    if [ "$with_audio" = "yes" ]; then
        if [ -n "$audio_device" ]; then
            wf-recorder $codec -r 30 -a"$audio_device" -f "$out" >>"$log" 2>&1 &
        else
            wf-recorder $codec -r 30 -a -f "$out" >>"$log" 2>&1 &
        fi
    else
        wf-recorder $codec -r 30 -f "$out" >>"$log" 2>&1 &
    fi
    pid=$!
    sleep 0.35
    if kill -0 "$pid" 2>/dev/null; then
        echo "$pid $(date +%s) $out" >"$pidfile"
        echo "$pid" >"$statefile"
        notify "Recording started" "$(basename "$out")"
        return 0
    fi
    rm -f "$out"
    return 1
}

setup_audio
vaapi="-c h264_vaapi -d ${VAAPI_DEVICE:-/dev/dri/renderD128}"
cpu="-c libx264 -p crf=23 -p preset=veryfast"

start_recording "$vaapi" yes && exit 0
start_recording "$vaapi" no && exit 0
start_recording "$cpu" yes && exit 0
start_recording "$cpu" no && exit 0

cleanup_audio
rm -f "$statefile"
notify "Recording failed" "see $log"
exit 1
