# vlswm configuration
# Key combos: MODIFIERS+KEY, modifiers are SUPER, SHIFT, CTRL, ALT.
# A keybind may list several combos separated by commas.
# Any name in [commands] can be bound to a key in [keybinds].
#
# This default is deliberately minimal and hardware-agnostic: brightness,
# volume, media keys, keyboard backlight and the microphone are not bound,
# because they depend on the machine. See README.md for ready-made snippets.
# The config in the repository may gain new options over time: after an
# update, compare it with your ~/.config/vlswm/config.

[keybinds]
launcher = "SUPER+D"
lock = "SUPER+L"
close = "SUPER+Q"
reload = "SUPER+R"
exit = "SUPER+ESC"
theme = "SUPER+T"
focus_prev = "SUPER+RIGHT"
focus_next = "SUPER+LEFT"
file_manager = "SUPER+E"
terminal = "SUPER+ENTER"
restart_terminal = "SUPER+SHIFT+R"
record = "SUPER+ALT+R"
record_stop = "SUPER+ALT+S"
screenshot = "SUPER+SHIFT+A"
clipboard = "SUPER+SHIFT+V"
notifications = "SUPER+N"
zen = "SUPER+Z"

[commands]
zen = "zen-browser"
record = "$HOME/.local/bin/vlswm-record start"
record_stop = "$HOME/.local/bin/vlswm-record stop"
screenshot = "$HOME/.local/bin/vlswm-screenshot"

[launcher]
terminal = "foot"
file_manager = "yazi"
font = "JetBrainsMono Nerd Font 16"
duration = 0

[theme]
foot = "~/.config/foot"

[animations]
duration = 200
curve = "ease-out"

[input]
repeat_delay = 200
repeat_rate = 40
scroll_speed = 0.5
layout = "us,ru"
layout_options = "grp:win_space_toggle"
repeat = "focus_next, focus_prev"

[record]
audio = "mic"                  # mic | system | both

[xwayland]
satellite = "xwayland-satellite"
display = ":1"

[output]
scale = 1.0
