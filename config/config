# vlswm configuration
# Key combos: MODIFIERS+KEY, modifiers are SUPER, SHIFT, CTRL, ALT.
# A keybind may list several combos separated by commas.
# Any name in [commands] can be bound to a key in [keybinds].

[keybinds]
launcher = "SUPER+D"
close = "SUPER+Q"
reload = "SUPER+R"
exit = "SUPER+ESC"
theme = "SUPER+T"
focus_prev = "SUPER+LEFT"
focus_next = "SUPER+RIGHT"
swap_prev = "SUPER+SHIFT+LEFT"
swap_next = "SUPER+SHIFT+RIGHT"
file_manager = "SUPER+E"
terminal = "SUPER+ENTER"
restart_terminal = "SUPER+SHIFT+R"
record = "SUPER+ALT+R"
screenshot = "SUPER+SHIFT+A"
clipboard = "SUPER+SHIFT+V"
zen = "SUPER+Z"
brightness_up = "XF86MonBrightnessUp, SUPER+F2"
brightness_down = "XF86MonBrightnessDown, SUPER+F1"
kbd_brightness_up = "XF86KbdBrightnessUp"
kbd_brightness_down = "XF86KbdBrightnessDown"
volume_up = "XF86AudioRaiseVolume, SUPER+F4"
volume_down = "XF86AudioLowerVolume, SUPER+F3"
volume_mute = "XF86AudioMute"

[commands]
zen = "zen-browser"
record = "$HOME/.local/bin/vlswm-record"
screenshot = "$HOME/.local/bin/vlswm-screenshot"
brightness_up = "brightnessctl -q set 5%+"
brightness_down = "brightnessctl -q set 5%-"
kbd_brightness_up = "brightnessctl --device='smc::kbd_backlight' set +10%"
kbd_brightness_down = "brightnessctl --device='smc::kbd_backlight' set 10%-"
volume_up = "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"
volume_down = "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
volume_mute = "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"

[launcher]
terminal = "foot"
file_manager = "yazi"
font = "JetBrainsMono Nerd Font 16"
duration = 0

[theme]
foot = "~/.config/foot"

[animations]
duration = 200
curve = "ease-out"

[input]
repeat_delay = 200
repeat_rate = 40
scroll_speed = 0.5
layout = "us,ru"
layout_options = "grp:win_space_toggle"
repeat = "focus_next, focus_prev, volume_up, volume_down, brightness_up, brightness_down"

[xwayland]
satellite = "xwayland-satellite"
display = ":1"
